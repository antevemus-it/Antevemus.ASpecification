// Mutation testing of the specification algebra (forward 037, D8 item 4; docs/contratos/RELEASING.md).
// Scope: src/Specifications/ plus src/AbstractSpecification.php and src/AbstractCompositeSpecification.php;
// since 2.4.0 (forward 041) also src/Serialization/ (the specification codec); since 2.5.0 (forward 048, RN-04)
// the new and changed files of the rule engine (RuleSpecificationRegistry, DynamicSpecificationEngine,
// RulePrecedence and the two catalogs), of the TCriteria bridge (the visitor, the builder and the three new
// TFilters) and of the asynchronous data sources; since 2.6.0 (forward 045) the stage runner of the resolution
// (ResolvedData, with the deferred group of the stage transports) and DataFetchException; since 2.7.0 the new files of
// the state machine for a real consumer (MachineDefinitionDiff, the drafts and PdoMachineDefinitionRepository, the
// tenant and lister ports, the ready-made migrations and their report, DefinitionDraftConflictException) and the
// calendars of the deadlines in business time; since 2.8.0 the write-behind hybrid repository (InMemoryAndFileRepository,
// RepositoryPersistenceMetaData, IWriteBehindBackend) and the caching decorators over PSR-16 (every file of src/Cache/:
// the cached catalog, flag store and partition index, the keys, the guarded cache and the catalog version); every other file of src/
// is excluded by the negative look-ahead below (a new top-level folder of src/ stays out of scope until it is
// named here). The Criteria/ classes extend Adianti's TFilter, so Infection loads tests/bootstrap.php (the stubs of the suite) itself.
// Runs in the scheduled workflow (.github/workflows/quality.yml)
// with a coverage driver (pcov); locally:
//
//   XDEBUG_MODE=off vendor/bin/infection --threads=max --only-covering-test-cases \
//       --initial-tests-php-options="-d pcov.enabled=1 -d pcov.directory=$PWD/src"
//
// minMsi / minCoveredMsi: the floor registered in RELEASING.md (measured 90.54 / 90.54 on 2026-10-19, 2.5.0, Quality workflow run 39263499101;
// Infection 0.35.8, PHP 8.4 with intl and pcov, the scope above: 4481 mutants, 4024 killed, 30 errors, 3 time-outs, 424
// escaped), a little below the measured score; a drop below it fails the run. Raise it when the score goes
// up, never lower it to make a run pass.
// 2.6.0 (forward 045): the 2.5.x scores were inflated. In a mutant process Infection replaces the file:// wrapper,
// proc_open() of Module 21's local server failed ("posix_spawn() failed: Bad file descriptor"), and every mutant
// covered by Module 21 counted as killed whatever the mutation. tests/Support/LocalHttpServer.php now redirects the
// streams in /bin/sh; measured locally (Infection 0.35.6, container, PHP 8.4 with pcov, memory_limit=2G): 4683 mutants,
// 4184 killed, 30 errors, 4 time-outs, 465 escaped, MSI 90.07 (ResolvedData 96.3, DataFetchException 100). The floor
// stays 89; the CI measurement of 2.6.0 goes to RELEASING.md on the release day.
// 2.7.0: the deadline calendars (src/StateMachine/Calendar/, every file, and UnknownDeadlineCalendarException) enter
// the scope as they are born; the changed deadline code of the core (DeadlineDefinition, StateMachine, the validator)
// is measured apart with --filter, the rest of src/StateMachine/ staying out of scope until it is named here.
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            "~^(?!Specifications/|Serialization/|AbstractSpecification\\.php$|AbstractCompositeSpecification\\.php$|Engine/(?:RuleSpecificationRegistry|DynamicSpecificationEngine|RulePrecedence|InMemoryRuleCatalog|PdoRuleCatalog)\\.php$|Criteria/(?:TAccentInsensitiveFilter|TSubqueryFilter|TConstantFilter|TCriteriaBuilder|CriteriaSpecificationVisitor)\\.php$|Resolution/(?:AsyncDataSource|AsyncPoll|AsyncTicket|CallableAsyncTicketStore|InMemoryAsyncTicketStore|IAsyncTicketStore)\\.php$|Resolution/ResolvedData\\.php$|Resolution/Exceptions/(?:DataPendingException|DataFetchException)\\.php$|StateMachine/MachineDefinitionDiff\\.php$|StateMachine/Persistence/(?:DefinitionDraftSupport|DraftInfo|MachineDefinitionDraft|PublishedMachineDefinition|IMachineDefinitionDrafts|ITenantScopedInstanceStore|IMachineInstanceLister)\\.php$|StateMachine/Persistence/Pdo/PdoMachineDefinitionRepository\\.php$|StateMachine/Runner/(?:ByStateNameMigration|MachineMigrations|InstanceMigration|IDefinitionAwareMachineMigration)\\.php$|StateMachine/Exceptions/DefinitionDraftConflictException\\.php$|StateMachine/Calendar/|StateMachine/Exceptions/UnknownDeadlineCalendarException\\.php$|Cache/|Repositories/RepositoryPersistenceMetaData\\.php$|Repositories/File/InMemoryAndFileRepository\\.php$|Contracts/Repositories/IWriteBehindBackend\\.php$)~"
        ]
    },
    "bootstrap": "tests/bootstrap.php",
    "timeout": 120,
    "logs": {
        "text": "coverage/infection/infection.log",
        "summary": "coverage/infection/summary.log",
        "json": "coverage/infection/infection.json",
        "perMutator": "coverage/infection/per-mutator.md"
    },
    "tmpDir": "coverage/infection/tmp",
    "phpUnit": {
        "configDir": "."
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 89,
    "minCoveredMsi": 89
}
